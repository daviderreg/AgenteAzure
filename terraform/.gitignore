terraform.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files containing secrets
*.tfvars
*.tfvars.json

# Exception: keep example variable files
!*.tfvars.example
!*.tfvars.sample

# Terraform plans
*.tfplan
*.plan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc


